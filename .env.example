# VOX — пример переменных окружения. Скопируйте в .env и заполните.
# cp .env.example .env

# ── Обязательные ──
DEEPGRAM_API_KEY=dg_...          # STT (console.deepgram.com)
OPENAI_API_KEY=sk-...            # Перевод (GPT-4o-mini) + TTS fallback (tts-1)
PORT=8080

# ── Путь к БД ──
# ЕДИНЫЙ путь для auth и billing (см. backend/db_config.py).
# В проде на Railway укажите путь на persistent volume.
VOX_DB_PATH=/data/vox.db

# ── Биллинг (Stripe) — опционально ──
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
BASE_URL=https://your-domain.com  # для email-ссылок и Stripe redirect

# ── Email-верификация (провайдер выбирается через EMAIL_PROVIDER) ──
# EMAIL_PROVIDER=resend | gmail
#
# PRODUCTION (Railway): используйте Resend HTTP API. В текущем Railway
# deployment Gmail SMTP оказался недоступен: [Errno 101] Network is unreachable.
# Resend реализован как production-провайдер через HTTPS, но фактическая
# доставка должна быть проверена после настройки EMAIL_PROVIDER, RESEND_API_KEY
# и MAIL_FROM в Railway.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...                       # console.resend.com → API Keys
MAIL_FROM=VOX <noreply@your-verified-domain>  # домен должен быть верифицирован в Resend
#
# LOCAL / DEV / legacy fallback — Gmail SMTP (smtp.gmail.com:465).
# GMAIL_APP_PASSWORD — это «App Password» Google, не обычный пароль.
# Используется только при EMAIL_PROVIDER=gmail.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Админка ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please    # ОБЯЗАТЕЛЬНО смените дефолт в проде!

# ── Настройки ──
DEFAULT_TARGET_LANG=uk
MAX_ROOM_PARTICIPANTS=10
ROOM_TIMEOUT_MINUTES=120

# Примечание: WHISPER_MODEL, VAD_THRESHOLD из старых версий БОЛЬШЕ НЕ
# ИСПОЛЬЗУЮТСЯ (STT через Deepgram).
