# VOX — пример переменных окружения. Скопируйте в .env и заполните.
# cp .env.example .env

# ── Обязательные ──
DEEPGRAM_API_KEY=dg_...          # STT (console.deepgram.com)
OPENAI_API_KEY=sk-...            # Перевод (GPT-4o-mini) + TTS fallback (tts-1)
PORT=8080

# ── Путь к БД ──
# ЕДИНЫЙ путь для auth и billing (см. backend/db_config.py).
# В проде на Railway укажите путь на persistent volume.
VOX_DB_PATH=/data/vox.db

# ── Биллинг (Stripe) — опционально ──
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
BASE_URL=https://your-domain.com  # для email-ссылок и Stripe redirect

# ── Email-верификация (Gmail SMTP) ──
# Код использует Gmail SMTP (smtp.gmail.com:465), НЕ Resend.
# GMAIL_APP_PASSWORD — это «App Password» Google, не обычный пароль.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Админка ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please    # ОБЯЗАТЕЛЬНО смените дефолт в проде!

# ── Настройки ──
DEFAULT_TARGET_LANG=uk
MAX_ROOM_PARTICIPANTS=10
ROOM_TIMEOUT_MINUTES=120

# Примечание: переменные RESEND_API_KEY, WHISPER_MODEL, VAD_THRESHOLD из старых
# версий БОЛЬШЕ НЕ ИСПОЛЬЗУЮТСЯ (email через Gmail SMTP; STT через Deepgram).
