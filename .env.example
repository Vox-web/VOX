# VOX — пример переменных окружения. Скопируйте в .env и заполните.
# cp .env.example .env

# ── Обязательные ──
DEEPGRAM_API_KEY=dg_...          # STT (console.deepgram.com)
OPENAI_API_KEY=sk-...            # Перевод (GPT-4o-mini) + TTS fallback (tts-1)
PORT=8080

# ── Путь к БД ──
# ЕДИНЫЙ путь для auth и billing (см. backend/db_config.py).
# В проде на Railway укажите путь на persistent volume.
VOX_DB_PATH=/data/vox.db

# ── Биллинг (Stripe) — опционально ──
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
BASE_URL=https://your-domain.com  # для email-ссылок и Stripe redirect

# ── Email-верификация (Gmail-аккаунт GMAIL_USER) ──
# Письма уходят ОТ адреса GMAIL_USER. Транспорт выбирается автоматически:
#
# PRODUCTION (Railway): Gmail API по HTTPS (порт 443). Исходящий SMTP на Railway
# заблокирован (подтверждено логами: 465 → [Errno 101] Network is unreachable,
# 587 → timeout), поэтому письма идут через Gmail REST API. Нужны OAuth2-креды
# (это НЕ app password):
GMAIL_USER=youraddress@gmail.com
GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxx      # scope https://www.googleapis.com/auth/gmail.send
#
# LOCAL / DEV fallback: Gmail SMTP (smtp.gmail.com), где SMTP разрешён.
# GMAIL_APP_PASSWORD — это «App Password» Google (работает только в SMTP, НЕ в API).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Админка ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please    # ОБЯЗАТЕЛЬНО смените дефолт в проде!

# ── Настройки ──
DEFAULT_TARGET_LANG=uk
MAX_ROOM_PARTICIPANTS=10
ROOM_TIMEOUT_MINUTES=120

# Примечание: WHISPER_MODEL, VAD_THRESHOLD из старых версий БОЛЬШЕ НЕ
# ИСПОЛЬЗУЮТСЯ (STT через Deepgram).
